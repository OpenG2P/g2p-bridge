# Build context for the api/celery images is the repo root; keep it lean.
# (Only core/ and docker/g2p-bridge-celery/run_celery.py are needed — the connectors
# are pulled from g2p-bridge-connectors by git ref, not from this build context.)
.git
.github
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.DS_Store
**/dump.rdb
**/celerybeat-schedule*
*.md

# Unrelated to the api/celery image builds
deployment/
# Exclude test/ contents EXCEPT test/sanity (needed by the sanity image). Use
# test/* (not test/) so the parent dir isn't excluded — required for the
# negation below to take effect.
test/*
!test/sanity
# ...but not local-only artifacts inside it (env wins over a baked config.yaml).
test/sanity/venv
test/sanity/.venv*
test/sanity/results
test/sanity/.sanity-runs
test/sanity/config.yaml
# Re-exclude caches under test/sanity (the !test/sanity negation above otherwise
# overrides the global **/__pycache__ rules for this path).
test/sanity/**/__pycache__
test/sanity/**/.pytest_cache
example-bank/
